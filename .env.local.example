# ============================================================
# SMTP — untuk notifikasi email admin saat ada order baru
# (dipakai oleh endpoint /api/notify-order di server.ts)
# Contoh Gmail: gunakan App Password, bukan password akun biasa.
# Kosongkan jika belum mau pakai notifikasi email — checkout tetap
# jalan normal, hanya notifikasi email yang dilewati.
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your-app-password
ADMIN_EMAIL=admin@binausaha.co.id

