{
  "rewrites": [
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/(.*)", "destination": "/index.html" },
    { "source": "/artikel", "destination": "/index.html" },
    { "source": "/artikel/:slug", "destination": "/api/artikel?slug=:slug" },
    { "source": "/paket/:key", "destination": "/api/paket?key=:key" }
  ]
}
