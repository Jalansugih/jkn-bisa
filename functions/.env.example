# These are NOT read from a plain .env file in production — they're set as
# Cloud Functions secrets so credentials never touch source control:
#
#   firebase functions:secrets:set SMTP_HOST
#   firebase functions:secrets:set SMTP_PORT
#   firebase functions:secrets:set SMTP_USER
#   firebase functions:secrets:set SMTP_PASS
#   firebase functions:secrets:set ADMIN_EMAIL
#
# This file just documents what each one should contain, and lets you run
# `firebase emulators:start` locally with a matching .env file if you want.

# SMTP server that will send the "new order" notification email.
# Example for Gmail: smtp.gmail.com (use an App Password, not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your-app-password

# Where new-order notification emails should be sent.
ADMIN_EMAIL=admin@binausaha.co.id
